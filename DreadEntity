local currentSpeed = 1
local targetMaxSpeed = 7000

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.FilterDescendantsInstances = {dread}

local chaseStartTime = os.clock()
local chaseMaxDuration = 12000

while (os.clock() - chaseStartTime) < chaseMaxDuration and isAttacking and isAlive and not isDespawning do
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then break end

    currentSpeed = math.min(targetMaxSpeed, currentSpeed + 8)

    local startPos = basepart.Position
    local targetPos = hrp.Position
    local direction = (targetPos - startPos).Unit
    local distance = (targetPos - startPos).Magnitude

    local rayResult = workspace:Raycast(startPos, direction * math.min(distance, 15), rayParams)

    if rayResult and rayResult.Instance and rayResult.Instance.CanCollide then
        local normal = rayResult.Normal
        local reflectDir = direction - 2 * (direction:Dot(normal)) * normal
        
        currentSpeed = math.max(16, currentSpeed - 25)

        local reboundTarget = basepart.Position + (reflectDir * 12)
        local reboundTime = 12 / currentSpeed

        currentTween = TweenService:Create(
            basepart,
            TweenInfo.new(reboundTime, Enum.EasingStyle.Quad),
            { CFrame = CFrame.new(reboundTarget) }
        )
        currentTween:Play()
        currentTween.Completed:Wait()
    else
        local dashDistance = math.min(distance, 20)
        local dashTarget = startPos + (direction * dashDistance)
        local dashTime = dashDistance / currentSpeed

        currentTween = TweenService:Create(
            basepart,
            TweenInfo.new(dashTime, Enum.EasingStyle.Linear),
            { CFrame = CFrame.new(dashTarget, dashTarget + direction) }
        )
        currentTween:Play()
        currentTween.Completed:Wait()
    end

    task.wait(0.02)
end
