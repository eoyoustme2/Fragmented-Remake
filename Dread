if eyes.PrimaryPart then
	eyes.PrimaryPart.Anchored = true
end

local startTime = tick()
local floatingConn
floatingConn = RunService.Heartbeat:Connect(function()
	if eyes and eyes.Parent and eyes.PrimaryPart then
		local delta = tick() - startTime
		local offsetY = math.sin(delta * 2.5) * 0.35
		eyes:PivotTo(targetCFrame * CFrame.new(0, offsetY, 0))
	else
		if floatingConn then floatingConn:Disconnect() end
	end
end)

