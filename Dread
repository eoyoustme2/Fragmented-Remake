end

local targetCFrame
if num > 0 and currentRoom.PathfindNodes:FindFirstChild(tostring(num)) then
	targetCFrame = currentRoom.PathfindNodes[tostring(num)].CFrame + Vector3.new(0, 6, 0)
else
	local roomCenter = currentRoom:FindFirstChild(currentRoom.Name) or currentRoom.PrimaryPart
