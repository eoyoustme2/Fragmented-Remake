local function customCameraShake(duration, maxMagnitude, roughness)
	local startTime = os.clock()
	local conn
	local Camera = workspace.CurrentCamera

	conn = RunService.RenderStepped:Connect(function()
		local elapsed = os.clock() - startTime
		if elapsed >= duration then
			conn:Disconnect()
			return
		end

		local progress = math.clamp(elapsed / duration, 0, 1)

		local easedProgress = TweenService:GetValue(progress, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

		local currentMagnitude = maxMagnitude * easedProgress

		local rotX = math.noise(elapsed * roughness, 0, 0) * currentMagnitude
		local rotY = math.noise(0, elapsed * roughness, 0) * currentMagnitude
		local rotZ = math.noise(0, 0, elapsed * roughness) * currentMagnitude

		Camera.CFrame = Camera.CFrame * CFrame.Angles(math.rad(rotX), math.rad(rotY), math.rad(rotZ))
	end)
end

